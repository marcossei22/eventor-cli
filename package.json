{
  "name": "eventor-cli-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "SDK + CLI + MCP para a Management API do Eventor (cliente headless pra agentes de IA).",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.2",
