{
  "name": "@eventor-run/sdk",
  "version": "0.5.1",
  "description": "Cliente HTTP tipado da Management API do Eventor (auth em camadas, retry, paginação, upload). Núcleo consumido pelo CLI e pelo MCP.",
  "license": "MIT",
  "keywords": [
    "eventor",
    "sdk",
    "api-client",
    "openapi",
    "typescript"
  ],
  "homepage": "https://github.com/marcossei22/eventor-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcossei22/eventor-cli.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/marcossei22/eventor-cli/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "gen": "openapi-typescript ../../openapi/eventor-v1.json --output ./src/generated/types.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "tsup"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "openapi-typescript": "^7.5.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
